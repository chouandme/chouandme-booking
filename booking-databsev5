<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>จองคิว Grooming — Chou&Me Pet Wellness</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐾</text></svg>">
<meta name="description" content="จองคิว Grooming — Chou&Me Pet Wellness บริการอาบน้ำ ตัดขน และสปาสำหรับสัตว์เลี้ยง">
<meta name="theme-color" content="#A07255">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Mitr:wght@300;400;500;600;700&family=Quicksand:wght@500;600;700&family=Sarabun:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --brown: #A07255;
  --cream: #F1F3EC;
  --gray: #CECCC3;
  --yellow-green: #F2F7CD;
  --slate: #ADB6B3;
  --blue: #6A95C0;
  --pink: #F4E2E2;
  --sand: #D8C3B3;
  --sage: #A0B995;
  --white: #FFFEFB;
  --text-dark: #3a2f27;
  --text-mid: #6b5c50;
  --radius-lg: 24px;
  --radius-xl: 36px;
  --radius-pill: 999px;
  --shadow-card: 0 2px 16px rgba(160,114,85,0.08);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Mitr', 'Sarabun', sans-serif;
  background: var(--cream);
  color: var(--text-dark);
  min-height: 100vh;
  overflow-x: hidden;
}

/* RIBBON */
.ribbon {
  background: var(--brown);
  color: #fff;
  padding: 10px 0;
  overflow: hidden;
  transform: rotate(-1.5deg) translateY(-2px);
  margin: 0 -20px;
  position: relative;
  z-index: 10;
  box-shadow: 0 4px 16px rgba(160,114,85,0.22);
}
.ribbon-inner { display:flex; white-space:nowrap; animation:marquee 24s linear infinite; width:max-content; }
.ribbon span { font-family:'Quicksand',sans-serif; font-size:14px; font-weight:600; letter-spacing:2px; padding:0 18px; }
.ribbon span.dot { color:var(--yellow-green); font-size:18px; padding:0 4px; }
@keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }

/* HEADER */
.site-header {
  background:var(--white); padding:16px 20px 14px;
  display:flex; align-items:center; justify-content:space-between;
  border-bottom:2px solid var(--sand);
  position:sticky; top:0; z-index:100;
}
.logo { font-family:'Quicksand',sans-serif; font-size:20px; font-weight:700; color:var(--brown); }
.logo span { color:var(--sage); }
.header-tag {
  background:var(--pink); color:var(--brown);
  font-size:11px; font-weight:600;
  padding:4px 12px; border-radius:var(--radius-pill); letter-spacing:1px;
}

/* HERO */
.hero {
  background:var(--white); padding:36px 20px 56px;
  text-align:center; position:relative; overflow:hidden;
}
.hero-deco { position:absolute; pointer-events:none; font-size:36px; opacity:.15; animation:floaty 4s ease-in-out infinite; }
.hero-deco.d1{top:12px;left:10px} .hero-deco.d2{top:20px;right:14px;animation-delay:1.2s;font-size:28px}
.hero-deco.d3{bottom:36px;left:20px;animation-delay:.7s;font-size:24px} .hero-deco.d4{bottom:28px;right:18px;animation-delay:1.8s}
@keyframes floaty{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-10px) rotate(5deg)}}
.hero-badge {
  display:inline-block; background:var(--yellow-green); color:var(--text-mid);
  font-size:12px; font-weight:600; padding:5px 16px; border-radius:var(--radius-pill);
  margin-bottom:14px; letter-spacing:1px; border:1.5px solid var(--sage);
}
.hero h1 { font-family:'Quicksand',sans-serif; font-size:clamp(32px,8vw,54px); font-weight:700; color:var(--brown); line-height:1.1; margin-bottom:12px; }
.hero h1 span { color:var(--sage); }
.hero p { font-size:13px; color:var(--text-mid); max-width:320px; margin:0 auto; line-height:1.7; font-weight:300; }

/* WAVE */
.wave{display:block;width:100%;height:44px;overflow:hidden;line-height:0}
.wave svg{width:100%;height:100%}

/* BOOKING WRAP */
.booking-wrap { padding:8px 16px 120px; max-width:560px; margin:0 auto; }

/* STEP NAV */
.step-nav { display:flex; align-items:center; justify-content:center; gap:0; padding:18px 0 20px; }
.step-pill {
  display:flex; align-items:center; gap:5px;
  background:var(--gray); color:#fff;
  font-family:'Quicksand',sans-serif; font-size:12px; font-weight:600;
  padding:5px 12px; border-radius:var(--radius-pill);
  transition:all .3s; white-space:nowrap; flex-shrink:0;
}
.step-pill .snum {
  width:18px;height:18px; background:rgba(255,255,255,.28); border-radius:50%;
  display:flex;align-items:center;justify-content:center; font-size:10px;
}
.step-pill.active { background:var(--brown); box-shadow:0 4px 14px rgba(160,114,85,.35); transform:scale(1.05); }
.step-pill.done { background:var(--sage); }
.step-connector { height:2px; flex:1; background:var(--gray); max-width:14px; min-width:4px; border-radius:2px; }
.step-connector.done { background:var(--sage); }

/* PROGRESS */
.progress-bar { height:4px; background:var(--sand); border-radius:2px; margin-bottom:22px; overflow:hidden; }
.progress-fill { height:100%; background:linear-gradient(90deg,var(--brown),var(--sage)); border-radius:2px; transition:width .45s ease; }

/* PAGES */
.booking-page { display:none; animation:fadeUp .38s ease; }
.booking-page.active { display:block; }
@keyframes fadeUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }

/* SUB-SECTIONS */
.sub-section { margin-bottom:26px; transition:opacity .35s ease; }
.sub-section.locked { opacity:.32; pointer-events:none; }
.sub-section.unlocked { opacity:1; pointer-events:all; }
.sub-section-header { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
.sub-num {
  width:28px;height:28px; border-radius:50%;
  background:var(--brown); color:#fff;
  font-family:'Quicksand',sans-serif; font-size:13px; font-weight:700;
  display:flex;align-items:center;justify-content:center; flex-shrink:0;
}
.sub-section.locked .sub-num { background:var(--gray); }
.section-title { font-family:'Quicksand',sans-serif; font-size:19px; font-weight:700; color:var(--brown); }
.sub-section.locked .section-title { color:var(--slate); }
.section-sub { font-size:12px; color:var(--text-mid); margin-bottom:13px; margin-top:2px; font-weight:300; padding-left:38px; }
.sub-divider { height:1px; background:linear-gradient(90deg,var(--sand),transparent); margin:2px 0 22px; border-radius:1px; }

/* CARDS */
.card-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:6px; }
.card-grid.col1 { grid-template-columns:1fr; }
.sel-card {
  background:var(--white); border:2.5px solid transparent;
  border-radius:var(--radius-lg); padding:16px 12px;
  cursor:pointer; transition:all .22s cubic-bezier(.34,1.56,.64,1);
  text-align:center; box-shadow:var(--shadow-card);
  position:relative; overflow:hidden;
  -webkit-tap-highlight-color:transparent; user-select:none;
}
.sel-card:hover { transform:translateY(-3px); box-shadow:0 8px 24px rgba(160,114,85,.13); }
.sel-card.selected { border-color:var(--brown); background:#fdf8f4; transform:translateY(-3px); box-shadow:0 8px 24px rgba(160,114,85,.18); }
.sel-card.selected::after {
  content:'✓'; position:absolute; top:7px;right:9px;
  background:var(--brown); color:#fff; width:18px;height:18px;
  border-radius:50%; font-size:10px; font-weight:700;
  display:flex;align-items:center;justify-content:center;
}
.card-emoji { font-size:28px; margin-bottom:6px; display:block; line-height:1; }
.card-label { font-family:'Quicksand',sans-serif; font-size:16px; font-weight:600; color:var(--text-dark); display:block; margin-bottom:3px; line-height:1.2; }
.card-sub { font-size:10px; color:var(--text-mid); line-height:1.5; font-weight:300; }

/* SERVICE CARDS */
.service-card {
  background:var(--white); border:2.5px solid transparent;
  border-radius:var(--radius-lg); padding:16px 14px;
  cursor:pointer; display:flex; align-items:flex-start; gap:13px;
  box-shadow:var(--shadow-card);
  transition:all .22s cubic-bezier(.34,1.56,.64,1);
  margin-bottom:10px; position:relative;
  -webkit-tap-highlight-color:transparent; user-select:none;
}
.service-card:hover { transform:translateX(4px); box-shadow:0 6px 24px rgba(160,114,85,.13); }
.service-card.selected { border-color:var(--brown); background:#fdf8f4; transform:translateX(4px); }
.service-card.selected::after {
  content:'✓'; position:absolute; top:10px;right:12px;
  background:var(--brown); color:#fff; width:20px;height:20px;
  border-radius:50%; font-size:11px; font-weight:700;
  display:flex;align-items:center;justify-content:center;
}
.svc-emoji { font-size:30px; flex-shrink:0; padding-top:2px; }
.svc-info { flex:1; min-width:0; }
.svc-name { font-family:'Quicksand',sans-serif; font-size:16px; font-weight:700; color:var(--text-dark); margin-bottom:4px; line-height:1.2; }
.svc-desc { font-size:11px; color:var(--text-mid); line-height:1.5; font-weight:300; }
.svc-tags { display:flex; flex-wrap:wrap; gap:4px; margin-top:7px; }
.svc-tag { background:var(--yellow-green); border-radius:var(--radius-pill); padding:2px 9px; font-size:10px; font-weight:600; color:var(--text-mid); }
.svc-tag.pink { background:var(--pink); color:var(--brown); }
.svc-price { font-family:'Quicksand',sans-serif; font-size:16px; font-weight:700; color:var(--brown); flex-shrink:0; padding-top:2px; white-space:nowrap; }

/* SERVICE NOTE */
.service-note {
  background:var(--pink); border-radius:14px; padding:11px 14px;
  font-size:11px; color:var(--text-mid); margin-bottom:14px;
  display:flex; gap:8px; align-items:flex-start;
}
.service-note .ni { font-size:14px; flex-shrink:0; }

/* ADDON */
.addon-grid { display:grid; grid-template-columns:1fr; gap:8px; margin-bottom:14px; }
.addon-card {
  background:var(--white); border:2.5px solid transparent;
  border-radius:16px; padding:11px 13px;
  cursor:pointer; display:flex; align-items:center; gap:11px;
  transition:all .18s; box-shadow:var(--shadow-card);
  -webkit-tap-highlight-color:transparent; user-select:none;
}
.addon-card:hover { transform:translateX(3px); }
.addon-card.selected { border-color:var(--sage); background:#f6fbf4; }
.addon-card.selected .addon-check { background:var(--sage); border-color:var(--sage); }
.addon-card.selected .addon-check::after { opacity:1; }
.addon-check {
  width:22px;height:22px; border-radius:6px; border:2.5px solid var(--gray);
  flex-shrink:0; position:relative; transition:all .18s;
}
.addon-check::after {
  content:'✓'; position:absolute; inset:0;
  display:flex;align-items:center;justify-content:center;
  color:#fff; font-size:12px; font-weight:700; opacity:0; transition:opacity .15s;
}
.addon-emoji { font-size:22px; flex-shrink:0; }
.addon-info { flex:1; min-width:0; }
.addon-name { font-family:'Quicksand',sans-serif; font-size:15px; font-weight:600; color:var(--text-dark); display:block; }
.addon-desc { font-size:10px; color:var(--text-mid); font-weight:300; line-height:1.4; }
.addon-price-tag { font-size:13px; font-weight:600; color:var(--brown); flex-shrink:0; }

/* DATE / TIME */
.date-input-wrap {
  background:var(--white); border-radius:var(--radius-lg);
  padding:18px; margin-bottom:14px; box-shadow:var(--shadow-card);
}
.date-input-wrap label { font-family:'Quicksand',sans-serif; font-size:15px; font-weight:600; color:var(--brown); display:block; margin-bottom:10px; }

/* CUSTOM CALENDAR */
.cal-wrap { user-select:none; }
.cal-header {
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:14px;
}
.cal-title {
  font-family:'Quicksand',sans-serif; font-size:16px; font-weight:700;
  color:var(--brown);
}
.cal-nav {
  background:var(--cream); border:2px solid var(--sand); border-radius:10px;
  width:34px; height:34px; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  font-size:16px; color:var(--brown); transition:all .16s;
  -webkit-tap-highlight-color:transparent;
}
.cal-nav:hover { background:var(--sand); }
.cal-nav:disabled { opacity:.3; cursor:not-allowed; }
.cal-dow-row {
  display:grid; grid-template-columns:repeat(7,1fr);
  gap:2px; margin-bottom:4px;
}
.cal-dow {
  text-align:center; font-family:'Quicksand',sans-serif;
  font-size:11px; font-weight:700;
  color:var(--slate); padding:4px 0;
}
.cal-dow.closed { color:var(--pink); }
.cal-grid {
  display:grid; grid-template-columns:repeat(7,1fr);
  gap:4px;
}
.cal-day {
  aspect-ratio:1; border-radius:12px;
  display:flex; align-items:center; justify-content:center;
  font-family:'Quicksand',sans-serif; font-size:13px; font-weight:600;
  cursor:pointer; transition:all .18s cubic-bezier(.34,1.56,.64,1);
  -webkit-tap-highlight-color:transparent;
  border:2px solid transparent;
  background:var(--cream); color:var(--text-dark);
}
.cal-day:hover:not(.disabled):not(.closed-day) { background:var(--sand); transform:scale(1.08); }
.cal-day.selected {
  background:var(--brown); color:#fff;
  border-color:var(--brown);
  box-shadow:0 4px 14px rgba(160,114,85,.28);
  transform:scale(1.1);
}
.cal-day.today { border-color:var(--sage); }
.cal-day.disabled { opacity:.28; cursor:not-allowed; }
.cal-day.closed-day { background:var(--pink); color:#d0a0a0; cursor:not-allowed; font-size:10px; }
.cal-day.empty { background:transparent; cursor:default; }
.cal-day.other-month { opacity:.3; }

.date-note {
  background:var(--pink); border-radius:12px; padding:10px 14px;
  font-size:13px; color:#b04040; font-weight:500; margin-top:10px; display:none;
}
.date-note.visible { display:block; }

.selected-date-badge {
  display:none; align-items:center; gap:8px;
  background:var(--yellow-green); border-radius:12px;
  padding:10px 14px; margin-top:12px;
  font-size:13px; font-weight:600; color:var(--text-mid);
}
.selected-date-badge.visible { display:flex; }
.selected-date-badge .sdb-icon { font-size:16px; }

.timeslot-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:7px; margin-top:10px; }
.timeslot-btn {
  background:var(--cream); border:2.5px solid transparent;
  border-radius:12px; padding:9px 4px;
  font-family:'Mitr',sans-serif; font-size:13px; font-weight:500;
  color:var(--text-dark); cursor:pointer; text-align:center;
  transition:all .16s; -webkit-tap-highlight-color:transparent;
}
.timeslot-btn:hover:not(:disabled) { background:var(--sand); }
.timeslot-btn.selected { background:var(--brown); color:#fff; border-color:var(--brown); }
.timeslot-btn:disabled { opacity:.32; cursor:not-allowed; }
.timeslot-btn.full { background:var(--pink); color:#c0a0a0; font-size:10px; }

/* BOOKING ESTIMATE CARD (above calendar) */
.estimate-card {
  background: linear-gradient(135deg, var(--yellow-green) 0%, #e8f0c8 100%);
  border-radius: 20px;
  padding: 16px 18px;
  margin-bottom: 16px;
  border: 2px solid #c8d49a;
  display: flex;
  align-items: center;
  gap: 14px;
}
.estimate-icon { font-size: 32px; flex-shrink: 0; }
.estimate-body { flex: 1; min-width: 0; }
.estimate-label {
  font-size: 11px; font-weight: 600; color: var(--text-mid);
  letter-spacing: 1px; margin-bottom: 3px;
}
.estimate-price {
  font-family: 'Quicksand', sans-serif;
  font-size: 22px; font-weight: 700; color: var(--brown);
  line-height: 1.1; margin-bottom: 2px;
}
.estimate-duration {
  font-size: 12px; color: var(--text-mid); display: flex; align-items: center; gap: 4px;
}
.estimate-duration b { color: var(--brown); }
.estimate-svc-tag {
  display: inline-block;
  background: rgba(160,114,85,.12);
  color: var(--brown);
  font-size: 10px; font-weight: 700;
  padding: 2px 8px; border-radius: 99px; margin-top: 5px;
}

/* FORM */
.form-field { margin-bottom:12px; }
.form-field label { font-family:'Quicksand',sans-serif; font-size:15px; font-weight:600; color:var(--brown); display:block; margin-bottom:5px; }
.form-field input, .form-field textarea {
  width:100%; padding:12px 14px;
  border:2.5px solid var(--sand); border-radius:14px;
  font-family:'Mitr',sans-serif; font-size:14px; color:var(--text-dark);
  background:var(--white); outline:none; transition:border .2s; resize:none;
}
.form-field input:focus, .form-field textarea:focus { border-color:var(--brown); }

/* SUMMARY */
.summary-card {
  background:var(--white); border-radius:var(--radius-xl);
  padding:22px 18px;
  box-shadow:0 8px 36px rgba(160,114,85,.12);
  margin-bottom:20px; border:2px solid var(--sand);
}
.summary-title { font-family:'Quicksand',sans-serif; font-size:19px; font-weight:700; color:var(--brown); margin-bottom:16px; }
.summary-row {
  display:flex; justify-content:space-between; align-items:flex-start;
  padding:8px 0; border-bottom:1px dashed var(--sand); gap:10px;
}
.summary-row:last-of-type { border-bottom:none; }
.s-label { font-size:12px; color:var(--text-mid); flex-shrink:0; }
.s-val { font-size:13px; font-weight:600; color:var(--text-dark); text-align:right; }
.price-big { background:var(--yellow-green); border-radius:14px; padding:16px 18px; margin-top:14px; text-align:center; }
.price-num { font-family:'Quicksand',sans-serif; font-size:28px; font-weight:700; color:var(--brown); display:block; }
.duration-badge {
  display:inline-flex; align-items:center; gap:5px;
  background:var(--pink); color:var(--brown);
  font-size:13px; font-weight:600;
  padding:5px 13px; border-radius:var(--radius-pill); margin-top:8px;
}
.price-note { font-size:10px; color:var(--text-mid); margin-top:6px; font-weight:300; line-height:1.5; }

/* BUTTONS */
.btn {
  display:block; width:100%; padding:15px 24px;
  border:none; border-radius:var(--radius-pill);
  font-family:'Quicksand',sans-serif; font-size:17px; font-weight:700;
  cursor:pointer; text-align:center;
  transition:all .22s cubic-bezier(.34,1.56,.64,1);
  -webkit-tap-highlight-color:transparent;
}
.btn:active { transform:scale(.97); }
.btn-primary { background:var(--brown); color:#fff; box-shadow:0 6px 20px rgba(160,114,85,.3); }
.btn-primary:hover { background:#8a6145; transform:translateY(-2px); }
.btn-primary:disabled { background:var(--gray); box-shadow:none; cursor:not-allowed; transform:none; }
.btn-secondary { background:var(--cream); color:var(--brown); border:2.5px solid var(--sand); margin-bottom:10px; }
.btn-secondary:hover { background:var(--sand); }
.btn-sage { background:var(--sage); color:#fff; box-shadow:0 6px 20px rgba(160,185,149,.32); }
.btn-sage:hover { background:#8da880; transform:translateY(-2px); }

/* MINI SUMMARY */
.mini-summary {
  position:fixed; bottom:0;left:0;right:0;
  background:var(--white); border-top:2px solid var(--sand);
  padding:10px 16px 14px; z-index:200; display:none;
  box-shadow:0 -4px 20px rgba(160,114,85,.11);
}
.mini-summary.visible { display:block; }
.mini-sum-row { display:flex; justify-content:space-between; align-items:center; }
.mini-sum-info { font-size:12px; color:var(--text-mid); }
.mini-sum-price { font-family:'Quicksand',sans-serif; font-size:20px; color:var(--brown); font-weight:700; }

/* SUCCESS */
.success-wrap { display:none; text-align:center; padding:48px 20px 80px; animation:fadeUp .5s ease; }
.success-wrap.visible { display:block; }
.success-icon { font-size:72px; margin-bottom:16px; animation:pop .5s cubic-bezier(.34,1.56,.64,1); }
@keyframes pop { from{transform:scale(0)} to{transform:scale(1)} }
.success-title { font-family:'Quicksand',sans-serif; font-size:28px; font-weight:700; color:var(--brown); margin-bottom:10px; }
.success-sub { font-size:14px; color:var(--text-mid); line-height:1.8; }

/* ALERT */
.full-alert {
  background:#fff0f0; border:2px solid #f4b0b0;
  border-radius:12px; padding:11px 14px;
  font-size:13px; color:#c05050; font-weight:600;
  text-align:center; margin-top:8px; display:none;
}
.full-alert.visible { display:block; }

/* ── ADMIN NAV TABS ── */
.admin-tab-btn {
  font-family:'Quicksand',sans-serif; font-size:12px; font-weight:700;
  padding:6px 14px; border-radius:var(--radius-pill); border:2px solid var(--sand);
  background:var(--cream); color:var(--text-mid); cursor:pointer;
  transition:all .2s; -webkit-tap-highlight-color:transparent;
}
.admin-tab-btn.active { background:var(--brown); color:#fff; border-color:var(--brown); }

/* ── ADMIN SHELL ── */
#adminView { display:none; }
#customerView { display:block; }

/* ADMIN WRAP */
.admin-wrap { max-width:1200px; margin:0 auto; padding:16px 14px 80px; }

/* SUMMARY CARDS */
.admin-summary-row { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin-bottom:20px; }
@media(min-width:640px){ .admin-summary-row{grid-template-columns:repeat(4,1fr);} }
.admin-stat {
  background:var(--white); border-radius:20px; padding:16px;
  box-shadow:var(--shadow-card); text-align:center;
}
.admin-stat .stat-icon { font-size:24px; margin-bottom:6px; }
.admin-stat .stat-num { font-family:'Quicksand',sans-serif; font-size:24px; font-weight:700; color:var(--brown); }
.admin-stat .stat-label { font-size:11px; color:var(--text-mid); margin-top:2px; }

/* VIEW TOGGLE */
.view-toggle { display:flex; gap:8px; margin-bottom:16px; }
.view-btn {
  font-family:'Quicksand',sans-serif; font-size:13px; font-weight:700;
  padding:8px 18px; border-radius:var(--radius-pill); border:2px solid var(--sand);
  background:var(--cream); color:var(--text-mid); cursor:pointer; transition:all .2s;
}
.view-btn.active { background:var(--brown); color:#fff; border-color:var(--brown); }

/* WEEK NAV */
.week-nav { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
.week-nav-btn {
  background:var(--cream); border:2px solid var(--sand); border-radius:10px;
  width:34px; height:34px; cursor:pointer; font-size:16px; color:var(--brown);
  display:flex; align-items:center; justify-content:center; transition:all .16s;
}
.week-nav-btn:hover { background:var(--sand); }
.week-label { font-family:'Quicksand',sans-serif; font-size:14px; font-weight:700; color:var(--brown); flex:1; text-align:center; }

/* WEEKLY VIEW */
.weekly-scroll-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x proximity;
  padding-bottom: 8px;
  /* hide scrollbar on iOS but keep functional */
  scrollbar-width: thin;
  scrollbar-color: var(--sand) transparent;
}
.weekly-scroll-wrap::-webkit-scrollbar { height: 5px; }
.weekly-scroll-wrap::-webkit-scrollbar-track { background: transparent; }
.weekly-scroll-wrap::-webkit-scrollbar-thumb { background: var(--sand); border-radius: 99px; }

.weekly-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 6px;
  min-width: max-content; /* forces all columns to stay in one row */
}
.week-col {
  width: 130px;
  flex: 0 0 130px; /* no grow, no shrink, fixed 130px */
  scroll-snap-align: start;
}
@media(min-width: 900px){
  .week-col { width: 150px; flex: 0 0 150px; }
}
.week-col-header {
  background:var(--white); border-radius:14px 14px 0 0;
  padding:10px 8px; text-align:center; border-bottom:2px solid var(--cream);
}
.week-col-header .wch-day { font-family:'Quicksand',sans-serif; font-size:12px; font-weight:700; color:var(--text-mid); }
.week-col-header .wch-date { font-family:'Quicksand',sans-serif; font-size:18px; font-weight:700; color:var(--brown); }
.week-col-header.today-col { background:var(--yellow-green); }
.week-col-header.closed-col { background:var(--pink); opacity:.7; }
.week-col-header .wch-closed { font-size:11px; color:#c05050; font-weight:600; }
.week-col-body {
  background:rgba(255,255,255,.5); border-radius:0 0 14px 14px;
  padding:6px; min-height:120px;
  border-left:1px solid var(--sand); border-right:1px solid var(--sand); border-bottom:1px solid var(--sand);
}

/* BOOKING CHIPS (weekly) */
.bk-chip {
  border-radius:12px; padding:8px 10px; margin-bottom:6px; cursor:pointer;
  transition:transform .15s, box-shadow .15s; font-size:11px; position:relative;
}
.bk-chip:hover { transform:translateY(-2px); box-shadow:0 4px 12px rgba(0,0,0,.12); }
.bk-chip-time { font-family:'Quicksand',sans-serif; font-weight:700; font-size:12px; }
.bk-chip-name { font-weight:600; margin-top:2px; }
.bk-chip-pet { opacity:.8; }
.bk-chip-status { display:inline-block; font-size:9px; font-weight:700; padding:1px 6px; border-radius:99px; margin-top:4px; background:rgba(255,255,255,.5); }

/* STATUS COLORS */
.st-waiting { background:#FFF9E6; border-left:3px solid #F5C842; color:#7a6000; }
.st-confirmed { background:#E8F0FB; border-left:3px solid #6A95C0; color:#1a3a6b; }
.st-inprogress { background:#E8F5EE; border-left:3px solid #A0B995; color:#2a5a38; }
.st-done { background:#ECECEC; border-left:3px solid #AEAEAE; color:#555; }
.st-cancelled { background:#FDECEA; border-left:3px solid #E07070; color:#8a2020; }

/* DAILY VIEW */
.daily-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }

.daily-outer {
  display: flex;
  flex-direction: column;
  min-width: 380px;
}

/* Header row: time gutter + groomer names */
.daily-header-row {
  display: flex;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--cream);
  padding-bottom: 6px;
}
.daily-gutter-header { width: 52px; flex-shrink: 0; }
.daily-groomer-header {
  flex: 1;
  font-family:'Quicksand',sans-serif; font-size:13px; font-weight:700;
  text-align:center; padding:10px 6px; background:var(--white);
  border-radius:14px; margin:0 3px; color:var(--brown);
  box-shadow:var(--shadow-card); transition:background .2s;
}
.daily-groomer-header.drag-target { background:rgba(160,185,149,.3); }

/* Timeline body: gutter + groomer columns side by side */
.daily-body-row {
  display: flex;
  flex-shrink: 0;
}
.daily-gutter {
  width: 52px;
  flex-shrink: 0;
  position: relative;
}
.daily-time-label {
  height: 30px; display:flex; align-items:center;
  font-size:11px; color:var(--text-mid); font-family:'Quicksand',sans-serif;
  font-weight:600; padding-right:6px; justify-content:flex-end;
  border-bottom: 1px dashed rgba(210,195,179,.3);
}
.daily-time-label.half { color:var(--gray); font-size:10px; }

/* GROOMER COLUMN */
.daily-groomer-col {
  flex: 1;
  position: relative;
  margin: 0 3px;
  border: 1px solid var(--sand);
  border-radius: 12px;
  overflow: hidden;
  transition: background .15s;
}
.daily-groomer-col.drag-active { background: rgba(160,185,149,.06); }

/* Background grid rows inside col */
.daily-slot-bg {
  position:absolute; left:0; right:0; height:30px;
  border-bottom:1px dashed rgba(210,195,179,.5);
  pointer-events:none;
}
.daily-slot-bg.hour-mark { border-bottom:1px solid var(--gray); }

/* DROP PREVIEW GHOST */
.drop-preview {
  position:absolute; left:3px; right:3px;
  background:rgba(160,185,149,.35);
  border:2px dashed var(--sage);
  border-radius:10px; pointer-events:none;
  z-index:5; display:none;
}

/* BOOKING BLOCK */
.daily-bk-block {
  position:absolute; left:3px; right:3px;
  border-radius:10px; padding:5px 8px 14px;
  font-size:11px; overflow:hidden;
  box-shadow:0 2px 8px rgba(0,0,0,.10);
  z-index:3; user-select:none; touch-action:none;
  cursor:grab;
}
.daily-bk-block:hover { box-shadow:0 4px 16px rgba(0,0,0,.16); }
.daily-bk-block.is-dragging { opacity:.4; z-index:1; pointer-events:none; }
.daily-bk-title { font-family:'Quicksand',sans-serif; font-weight:700; font-size:12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.daily-bk-sub { opacity:.85; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:1px; }
.daily-bk-time-badge {
  position:absolute; bottom:3px; right:6px;
  font-family:'Quicksand',sans-serif; font-size:9px; font-weight:700; opacity:.7;
}

/* RESIZE HANDLES */
.resize-handle {
  position:absolute; left:0; right:0; height:12px;
  cursor:ns-resize; z-index:10;
  display:flex; align-items:center; justify-content:center;
}
.resize-handle::after {
  content:''; display:block; width:24px; height:3px;
  background:rgba(0,0,0,.18); border-radius:2px;
}
.resize-handle-top { top:0; }
.resize-handle-bottom { bottom:0; }

/* TIME TOOLTIP */
.time-tooltip {
  position:fixed; background:var(--text-dark); color:#fff;
  padding:4px 10px; border-radius:8px; font-family:'Quicksand',sans-serif;
  font-size:12px; font-weight:700; z-index:999; pointer-events:none;
  display:none; white-space:nowrap;
}

/* MODAL edit fields */
.modal-edit-section {
  background:var(--cream); border-radius:16px;
  padding:14px; margin-top:14px;
}
.modal-edit-title {
  font-family:'Quicksand',sans-serif; font-size:13px; font-weight:700;
  color:var(--brown); margin-bottom:10px;
}
.modal-edit-row {
  display:grid; grid-template-columns:auto 1fr;
  gap:6px 10px; align-items:center; margin-bottom:8px;
}
.modal-edit-row label { font-size:12px; color:var(--text-mid); white-space:nowrap; }
.modal-edit-row input,
.modal-edit-row select,
.modal-edit-row textarea {
  width:100%; padding:7px 10px;
  border:2px solid var(--sand); border-radius:10px;
  font-family:'Mitr',sans-serif; font-size:13px;
  color:var(--text-dark); background:var(--white);
  outline:none; transition:border .2s;
}
.modal-edit-row input:focus,
.modal-edit-row select:focus,
.modal-edit-row textarea:focus { border-color:var(--brown); }
.modal-edit-row textarea { resize:none; grid-column:1/-1; }
.modal-err { font-size:12px; color:#c05050; font-weight:600; margin-top:6px; display:none; }
.modal-err.visible { display:block; }
.modal-save-row { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; }


/* MODAL */
.modal-overlay {
  position:fixed; inset:0; background:rgba(58,47,39,.45);
  z-index:500; display:flex; align-items:flex-end; justify-content:center;
  animation:fadeIn .2s ease;
}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal-overlay.hidden { display:none; }
.modal-sheet {
  background:var(--white); border-radius:28px 28px 0 0;
  width:100%; max-width:540px; max-height:90vh; overflow-y:auto;
  padding:24px 20px 36px; animation:slideUp .28s cubic-bezier(.34,1.4,.64,1);
}
@keyframes slideUp{from{transform:translateY(60px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-handle { width:40px; height:4px; background:var(--sand); border-radius:2px; margin:0 auto 18px; }
.modal-title { font-family:'Quicksand',sans-serif; font-size:20px; font-weight:700; color:var(--brown); margin-bottom:16px; }
.modal-row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--sand); font-size:13px; gap:10px; }
.modal-row:last-of-type{border-bottom:none}
.modal-row .ml { color:var(--text-mid); flex-shrink:0; }
.modal-row .mv { font-weight:600; text-align:right; }
.modal-actions { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:18px; }
.modal-btn {
  padding:11px 8px; border-radius:14px; font-family:'Quicksand',sans-serif;
  font-size:13px; font-weight:700; border:none; cursor:pointer;
  transition:all .18s; text-align:center; -webkit-tap-highlight-color:transparent;
}
.modal-btn.call { background:var(--yellow-green); color:var(--text-dark); }
.modal-btn.line { background:#06C755; color:#fff; }
.modal-btn.cancel-bk { background:var(--pink); color:#c05050; }
.modal-btn.change-status { background:var(--blue); color:#fff; }
.status-select {
  width:100%; padding:11px 14px; border:2px solid var(--sand);
  border-radius:12px; font-family:'Mitr',sans-serif; font-size:14px;
  color:var(--text-dark); background:var(--cream); outline:none;
  margin-top:12px;
}

/* TOAST */
.toast {
  position:fixed; bottom:80px; left:50%; transform:translateX(-50%) translateY(20px);
  background:var(--text-dark); color:#fff;
  padding:11px 22px; border-radius:var(--radius-pill);
  font-size:13px; font-weight:600; z-index:600;
  opacity:0; transition:all .3s; pointer-events:none; white-space:nowrap;
}
.toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
.toast.error { background:#c05050; }
.toast.success { background:var(--sage); }

/* DRAG DROP — kept for weekly view week-col-body hover */
.week-col-body.drag-over { background:rgba(160,185,149,.18) !important; outline:2px dashed var(--sage); border-radius:0 0 14px 14px; }

/* DEBUG TABLE */
.debug-table { width:100%; border-collapse:collapse; font-size:11px; }
.debug-table th { background:var(--cream); color:var(--text-mid); font-weight:700; padding:6px 8px; text-align:left; border-bottom:2px solid var(--sand); white-space:nowrap; font-family:'Quicksand',sans-serif; }
.debug-table td { padding:6px 8px; border-bottom:1px dashed var(--sand); color:var(--text-dark); vertical-align:top; max-width:140px; word-break:break-word; }
.debug-table tr:hover td { background:var(--cream); }
.debug-table .demo-row td { opacity:.55; }
.debug-pill { display:inline-block; padding:1px 7px; border-radius:99px; font-size:10px; font-weight:700; }
</style>
