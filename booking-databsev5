function buildTimeslots(date){
  const slots=[];
  for(let h=9;h<20;h++){
    if(h===13) continue; // lunch break — no 13:00 or 13:30
    slots.push(`${String(h).padStart(2,'0')}:00`);
    if(h<19) slots.push(`${String(h).padStart(2,'0')}:30`);
  }
  document.getElementById('timeslotGrid').innerHTML=slots.map(t=>{
    const busy=countBusy(date,t),full=busy>=2;
    return `<button class="timeslot-btn${full?' full':''}" ${full?'disabled':''} onclick="selectTime(this,'${t}')">${full?'เต็ม':t}</button>`;
  }).join('');
}

function countBusy(date,slot){
  const [sh,sm]=slot.split(':').map(Number),ss=sh*60+sm;
  let n=0;
  bookings.forEach(b=>{
    if(b.date!==date||b.status==='ยกเลิก') return;
    const t=b.startTime||b.time||'00:00';
    const dur=b.estimatedDurationMax||b.durationMin||60;
    const [bh,bm]=t.split(':').map(Number),bs=bh*60+bm,be=bs+dur;
    if(ss>=bs&&ss<be) n++;
  });
  return n;
}

