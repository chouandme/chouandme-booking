  // Update badge
  const d=new Date(dateStr+'T12:00:00');
  const badge=document.getElementById('selectedDateBadge');
  document.getElementById('selectedDateText').textContent=
    d.toLocaleDateString('th-TH',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  badge.classList.add('visible');

  // Re-render calendar to show selection
  renderCal();

  // Show timeslots
  buildTimeslots(dateStr);
  document.getElementById('timeWrap').style.display='block';
