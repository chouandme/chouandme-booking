// ── 2. CREATE a new booking ──
async function createBooking(bk) {
  // Always attempt — do not gate on dbConnected
  // (dbConnected may be false on first load if table was empty)
  const body = toDb(bk, false); // omit id — let Supabase auto-generate
  console.log('createBooking: sending to Supabase:', JSON.stringify(body));
  try {
    const res = await fetch(SUPABASE_URL + '/rest/v1/bookings', {
      method: 'POST',
      headers: SB_HEADERS,
      body: JSON.stringify(body)
    });
    const text = await res.text(); // read raw response for diagnosis
    console.log('createBooking: HTTP', res.status, text);
    if (!res.ok) {
      let detail = text;
      try { detail = JSON.stringify(JSON.parse(text)); } catch(e) {}
      throw new Error('HTTP ' + res.status + ': ' + detail);
    }
    let rows;
    try { rows = JSON.parse(text); } catch(e) { rows = []; }
    const saved = Array.isArray(rows) && rows[0] ? fromDb(rows[0]) : bk;
    console.log('createBooking: inserted successfully, id=' + (saved.id || 'unknown'));
    return saved;
  } catch (err) {
    console.error('createBooking error:', err.message);
    // Show user-friendly message with hint
    setDbStatus('error', '❌ บันทึกไม่สำเร็จ: ' + err.message.slice(0, 100));
    throw err;
  }
}

