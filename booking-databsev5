// ── CONFIRM ──
async function confirmBooking(){
  try {
    // ── 1. Derive duration & price safely ──
    const dur = calcDuration();
    const mn = dur && typeof dur.mn === 'number' ? dur.mn : 60;
    const mx = dur && typeof dur.mx === 'number' ? dur.mx : 90;

    const pr = calcPrice();
    const pMin = pr && typeof pr.min === 'number' ? pr.min : 0;
    const pMax = pr && typeof pr.max === 'number' ? pr.max : 0;

    // ── 2. Service label — guard against undefined haircut ──
    const petType   = S.petType  || 'dog';
    const animalTh  = petType === 'dog' ? 'สุนัข' : 'แมว';
    let svcLabel;
    if (S.haircut === 'clipper') {
      svcLabel = 'อาบน้ำ + ตัดขน (ปัตตาเลี่ยน)';
    } else if (S.haircut === 'scissor') {
      svcLabel = 'อาบน้ำ + ตัดขน (กรรไกร)';
    } else {
      svcLabel = 'อาบน้ำ' + animalTh;
    }

    // ── 3. Add-on labels ──
    const addonArr = Array.isArray(S.addons) ? S.addons : [];
    const addonLabels = addonArr
      .map(av => { const a = addons.find(x => x.val === av); return a ? a.label : null; })
      .filter(Boolean);

    // ── 4. Coat label ──
    const coatList  = petType === 'dog' ? dogCoats : catCoats;
    const coatData  = coatList.find(c => c.val === S.coat);
    const coatLabel = coatData ? coatData.label : (S.coat || '');

    // ── 5. End time — guard against null startTime ──
    const startTime = S.time || '09:00';
    const endTime   = calcEndTimeStr(startTime, mx);

    // ── 6. Auto-assign groomer ──
    const newDate   = S.date || '';
    const dayBksOnDate = bookings.filter(b => b.date === newDate && b.status !== 'ยกเลิก');
    const g1Busy = dayBksOnDate.filter(b => b.groomerId === 'groomer1')
      .some(b => overlaps(b.startTime, b.estimatedDurationMax, startTime, mx));
    const groomerId = g1Busy ? 'groomer2' : 'groomer1';

    // ── 7. Build canonical booking object ──
    const newBk = {
      id:                   'BK-' + Date.now(),
      customerName:         S.custName  || '',
      phone:                S.custPhone || '',
      petName:              S.petName   || '',
      petType:              petType,
      weightRange:          S.weight    || '',
      coatType:             coatLabel,
      service:              svcLabel,
      addOns:               addonLabels,
      estimatedPriceMin:    pMin,
      estimatedPriceMax:    pMax,
      estimatedDurationMin: mn,
      estimatedDurationMax: mx,
      date:                 S.date      || '',
      startTime:            startTime,
      endTime:              endTime,
      groomerId:            groomerId,
      status:               'รอยืนยัน',
      notes:                S.custNote  || '',
      createdAt:            new Date().toISOString()
    };

    // ── 8. Save to Supabase — do NOT push to local cache until DB confirms ──
    const confirmBtn = document.querySelector('button[onclick="confirmBooking()"]');
    if (confirmBtn) { confirmBtn.disabled = true; confirmBtn.textContent = 'กำลังบันทึก...'; }

    try {
      const saved = await createBooking(newBk);
      // Use the DB-returned record (which has the real auto-generated id)
      const finalBk = saved || newBk;

      console.log('--- booking saved ---');
      console.log(JSON.stringify(finalBk, null, 2));

      // Reload all bookings from DB to get fresh data with correct ids
      await loadBookings();
      console.log('--- all bookings (' + bookings.length + ') ---');
      bookings.forEach(function(b, i) {
        console.log(i + ' | ' + b.id + ' | ' + b.date + ' ' + b.startTime + ' | ' + b.petName + ' | ' + b.status);
      });

