    status:        bk.status         || 'รอยืนยัน',
    notes:         bk.notes          || '',
    created_at:    bk.createdAt      || new Date().toISOString()
  };
  // Only include id when explicitly requested (e.g. for updates)
  // On INSERT, let Supabase auto-generate the id
  if (includeId && bk.id) row.id = bk.id;
  return row;
}

function fromDb(row) {
  let addOns = [];
  try { addOns = JSON.parse(row.addons || '[]'); } catch(e) { addOns = []; }
