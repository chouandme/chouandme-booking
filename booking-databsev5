      alert('ไม่สามารถบันทึกการจองได้\n\n' + dbErr.message + '\n\nกรุณาตรวจสอบ Supabase RLS policy');
      if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.textContent = '✓ ยืนยันการจอง'; }
