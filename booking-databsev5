      <div class="daily-groomer-header" id="hdr-groomer2">ช่าง 2</div>
    </div>
    <div class="daily-body-row">
      <div class="daily-gutter">${gutterHtml}</div>
      ${buildCol(g1Bks, 'groomer1')}
      ${buildCol(g2Bks, 'groomer2')}
    </div>`;

  attachDailyEvents();
}

// ══════════════════════════════════════════
// POINTER-BASED DRAG & RESIZE (works on iPad touch)
// ══════════════════════════════════════════
let ix = null; // active interaction — see attachDailyEvents
// ══════════════════════════════════════════
// DRAG & RESIZE — Safari-safe touch + mouse
// Uses document-level move/end listeners instead of setPointerCapture
// ══════════════════════════════════════════

// helpers to get clientX/Y from either mouse or touch event
function evtXY(e) {
  if (e.touches && e.touches.length > 0) {
    return { x: e.touches[0].clientX, y: e.touches[0].clientY };
  }
  if (e.changedTouches && e.changedTouches.length > 0) {
    return { x: e.changedTouches[0].clientX, y: e.changedTouches[0].clientY };
  }
  return { x: e.clientX, y: e.clientY };
}

const tooltip = document.getElementById('timeTooltip');
function showTooltip(x, y, text) {
  if (!tooltip) return;
  tooltip.textContent = text;
  tooltip.style.display = 'block';
  tooltip.style.left = Math.min(x + 14, window.innerWidth - 100) + 'px';
  tooltip.style.top  = Math.max(y - 36, 4) + 'px';
}
function hideTooltip() { if (tooltip) tooltip.style.display = 'none'; }

function getColRect(groomer) {
  const col = document.getElementById('col-' + groomer);
  return col ? col.getBoundingClientRect() : null;
}
function groomerAtClientX(clientX) {
  for (const g of ['groomer1', 'groomer2']) {
    const r = getColRect(g);
    if (r && clientX >= r.left && clientX <= r.right) return g;
  }
  return null;
}
function snapToPx(px) { return Math.round(px / SLOT_PX) * SLOT_PX; }

function canGroomerBook(groomer, startTime, dur, excludeId) {
  return !getGroomerBks(groomer).some(b =>
    b.id !== excludeId &&
    overlaps(b.startTime, b.estimatedDurationMax, startTime, dur)
  );
}

function setGhost(groomer, topPx, heightPx, show, ok) {
  const g = document.getElementById('ghost-' + groomer);
  if (!g) return;
  g.style.display    = show ? 'block' : 'none';
  g.style.top        = topPx + 'px';          // no HEADER_H — col starts at 09:00
  g.style.height     = Math.max(heightPx, 10) + 'px';
  g.style.background = ok ? 'rgba(160,185,149,.4)' : 'rgba(240,120,120,.3)';
  g.style.borderColor = ok ? 'var(--sage)' : '#e07070';
}
function clearGhosts() {
  ['groomer1', 'groomer2'].forEach(g => {
    const ghost = document.getElementById('ghost-' + g);
    if (ghost) ghost.style.display = 'none';
    const hdr = document.getElementById('hdr-' + g);
    if (hdr) hdr.classList.remove('drag-target');
    const col = document.getElementById('col-' + g);
    if (col) col.classList.remove('drag-active');
  });
}

// ── attach events after renderDaily ──
function attachDailyEvents() {
  document.querySelectorAll('.daily-bk-block').forEach(el => {
    el.addEventListener('mousedown',  onBkDown, false);
    el.addEventListener('touchstart', onBkDown, { passive: false });
  });
  document.querySelectorAll('.resize-handle').forEach(el => {
    el.addEventListener('mousedown',  onResizeDown, false);
    el.addEventListener('touchstart', onResizeDown, { passive: false });
  });
}

// ── DRAG: start ──
function onBkDown(e) {
  // Don't start drag from resize handle
  if (e.target.dataset && e.target.dataset.resize) return;
  e.preventDefault();
  const el      = e.currentTarget;
  const bkId    = el.dataset.id;
  const groomer = el.dataset.groomer;
  const bk      = bookings.find(b => b.id === bkId);
  if (!bk) return;
  const { x, y } = evtXY(e);

  // Capture how far down within the block the user touched,
  // so the block doesn't jump when dragging starts.
  const rect = el.getBoundingClientRect();
  const offsetWithinBlock = y - rect.top; // px from block top to touch point

  ix = {
    type: 'drag', bkId, groomer,
    startX: x, startY: y,
    startPx: pxFromOpen(bk.startTime),
    offsetWithinBlock,            // ← new
    dur: bk.estimatedDurationMax || 60,
    moved: false,
    pendingGroomer: groomer,
    pendingTime: bk.startTime,
    pendingOk: true
  };
  document.addEventListener('mousemove',   onDragMove,  false);
  document.addEventListener('mouseup',     onDragEnd,   false);
  document.addEventListener('touchmove',   onDragMove,  { passive: false });
  document.addEventListener('touchend',    onDragEnd,   false);
  document.addEventListener('touchcancel', onDragEnd,   false);
}

// ── DRAG: move ──
function onDragMove(e) {
  if (!ix || ix.type !== 'drag') return;
  e.preventDefault();
  const { x, y } = evtXY(e);
  const dy = y - ix.startY;
  const dx = x - ix.startX;

  if (!ix.moved && Math.abs(dy) < 6 && Math.abs(dx) < 6) return;
  ix.moved = true;

  // dim the original block
  const el = document.querySelector(`.daily-bk-block[data-id="${ix.bkId}"]`);
  if (el) el.classList.add('is-dragging');

  const targetGroomer = groomerAtClientX(x) || ix.groomer;

  // col div top in screen space = exactly the 09:00 row (no header inside col)
  // rawPx = distance from 09:00 to where the block TOP should land
  const colRect = getColRect(targetGroomer) || getColRect(ix.groomer);
  let rawPx;
  if (colRect) {
    rawPx = (y - colRect.top) - ix.offsetWithinBlock;
  } else {
    rawPx = ix.startPx + (y - ix.startY);
  }

  const snapPx  = snapToPx(rawPx);
  const maxPx   = totalPx() - ix.dur / 30 * SLOT_PX;
  const clamped = Math.max(0, Math.min(maxPx, snapPx));
  const newTime = pxToTime(clamped);
  const heightPx = ix.dur / 30 * SLOT_PX;
  const ok = canGroomerBook(targetGroomer, newTime, ix.dur, ix.bkId);

  clearGhosts();
  setGhost(targetGroomer, clamped, heightPx - 4, true, ok);
  const hdr = document.getElementById('hdr-' + targetGroomer);
  if (hdr) hdr.classList.add('drag-target');
  const col = document.getElementById('col-' + targetGroomer);
  if (col) col.classList.add('drag-active');

  ix.pendingGroomer = targetGroomer;
  ix.pendingTime    = newTime;
  ix.pendingOk      = ok;
  showTooltip(x, y, newTime);
}

// ── DRAG: end ──
function onDragEnd(e) {
  if (!ix || ix.type !== 'drag') return;
  document.removeEventListener('mousemove',  onDragMove);
  document.removeEventListener('mouseup',    onDragEnd);
  document.removeEventListener('touchmove',  onDragMove);
  document.removeEventListener('touchend',   onDragEnd);
  document.removeEventListener('touchcancel',onDragEnd);

  const el = document.querySelector(`.daily-bk-block[data-id="${ix.bkId}"]`);
  if (el) el.classList.remove('is-dragging');
  clearGhosts();
  hideTooltip();

  const bkId = ix.bkId;
  const moved = ix.moved;
  const pendingOk = ix.pendingOk;
  const pendingTime = ix.pendingTime;
  const pendingGroomer = ix.pendingGroomer;
  ix = null; // clear BEFORE any re-render

  if (!moved) {
    // It was a tap/click — open the modal
    openModal(bkId);
    return;
  }

  if (pendingOk) {
    const bk = bookings.find(b => b.id === bkId);
    if (bk) {
      bk.startTime = pendingTime;
      bk.endTime   = calcEndTime(pendingTime, bk.estimatedDurationMax);
      bk.groomerId = pendingGroomer;
      bk.date      = adminDaySelected;
      updateBooking(bk.id, { startTime: bk.startTime, endTime: bk.endTime, groomerId: bk.groomerId, date: bk.date });
      showToast('ย้ายคิวเรียบร้อยแล้ว ✓', 'success');
      renderCurrentView(); buildAdminStats();
    }
  } else {
    showToast('ช่วงเวลานี้เต็มแล้ว ไม่สามารถย้ายคิวได้', 'error');
    renderDaily();
  }
}

// ── RESIZE: start ──
function onResizeDown(e) {
  e.preventDefault();
  e.stopPropagation();
  const handle  = e.currentTarget;
  const edge    = handle.dataset.resize;
  const bkId    = handle.dataset.id;
  const groomer = handle.dataset.groomer;
  const bk = bookings.find(b => b.id === bkId);
  if (!bk) return;
  const { y } = evtXY(e);
  ix = {
    type: 'resize', bkId, groomer, edge,
    startY:      y,
    origStartPx: pxFromOpen(bk.startTime),
    origEndPx:   pxFromOpen(bk.endTime),
    moved: false,
    pendingStart: bk.startTime,
    pendingEnd:   bk.endTime,
    pendingDur:   bk.estimatedDurationMax || 60
  };
  document.addEventListener('mousemove',  onResizeMove, false);
  document.addEventListener('mouseup',    onResizeEnd,  false);
  document.addEventListener('touchmove',  onResizeMove, { passive: false });
  document.addEventListener('touchend',   onResizeEnd,  false);
  document.addEventListener('touchcancel',onResizeEnd,  false);
}

// ── RESIZE: move ──
function onResizeMove(e) {
  if (!ix || ix.type !== 'resize') return;
  e.preventDefault();
  const { x, y } = evtXY(e);
  const dy = y - ix.startY;
  ix.moved = true;

  let newStartPx = ix.origStartPx;
  let newEndPx   = ix.origEndPx;

  if (ix.edge === 'bottom') {
    newEndPx = snapToPx(ix.origEndPx + dy);
    newEndPx = Math.max(newStartPx + SLOT_PX, Math.min(totalPx(), newEndPx));
  } else {
    newStartPx = snapToPx(ix.origStartPx + dy);
    newStartPx = Math.max(0, Math.min(newEndPx - SLOT_PX, newStartPx));
  }

  const newStart = pxToTime(newStartPx);
  const newEnd   = pxToTime(newEndPx);
  const dur = (newEndPx - newStartPx) / SLOT_PX * 30;

  // live-update the block visually — top is pxFromOpen (no HEADER_H)
  const el = document.querySelector(`.daily-bk-block[data-id="${ix.bkId}"]`);
  if (el) {
    el.style.top    = newStartPx + 'px';
    el.style.height = Math.max(newEndPx - newStartPx - 4, 26) + 'px';
    const badge = el.querySelector('.daily-bk-time-badge');
    if (badge) badge.textContent = newStart + '–' + newEnd;
  }

  ix.pendingStart = newStart;
  ix.pendingEnd   = newEnd;
  ix.pendingDur   = dur;
  showTooltip(x, y, newStart + '–' + newEnd);
}

// ── RESIZE: end ──
function onResizeEnd(e) {
  if (!ix || ix.type !== 'resize') return;
  document.removeEventListener('mousemove',  onResizeMove);
  document.removeEventListener('mouseup',    onResizeEnd);
  document.removeEventListener('touchmove',  onResizeMove);
  document.removeEventListener('touchend',   onResizeEnd);
  document.removeEventListener('touchcancel',onResizeEnd);
  hideTooltip();

  if (ix.moved) {
    const bk = bookings.find(b => b.id === ix.bkId);
    if (bk) {
      const ok = canGroomerBook(ix.groomer, ix.pendingStart, ix.pendingDur, ix.bkId);
      if (ok) {
        bk.startTime = ix.pendingStart;
        bk.endTime   = ix.pendingEnd;
        bk.estimatedDurationMin = ix.pendingDur;
        bk.estimatedDurationMax = ix.pendingDur;
        updateBooking(bk.id, { startTime: bk.startTime, endTime: bk.endTime, estimatedDurationMin: bk.estimatedDurationMin, estimatedDurationMax: bk.estimatedDurationMax });
        showToast('ปรับเวลาเรียบร้อยแล้ว ✓', 'success');
        renderCurrentView(); buildAdminStats();
      } else {
        showToast('ไม่สามารถปรับขนาดได้ ช่วงเวลาชนกับการจองอื่น', 'error');
        renderDaily();
      }
    }
  }
  ix = null;
}

