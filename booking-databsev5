function timeToMin(t) {
  if (!t || !t.includes(':')) return 0;
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
}
function overlaps(t1, d1, t2, d2) {
  const s1 = timeToMin(t1), e1 = s1 + (d1 || 0);
  const s2 = timeToMin(t2), e2 = s2 + (d2 || 0);
  return s1 < e2 && e1 > s2;
}
function calcEndTime(startTime, durationMin) {
  if (!startTime || !startTime.includes(':')) return '10:00';
  const [h, m] = startTime.split(':').map(Number);
  const total = h * 60 + m + (durationMin || 60);
  return String(Math.floor(total / 60) % 24).padStart(2, '0') + ':' + String(total % 60).padStart(2, '0');
}

