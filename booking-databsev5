  if (fields.service        !== undefined) partial.service       = fields.service;
  if (fields.addOns         !== undefined) partial.addons        = JSON.stringify(fields.addOns);
  if (fields.estimatedPriceMin    !== undefined) partial.price_min    = fields.estimatedPriceMin;
  if (fields.estimatedPriceMax    !== undefined) partial.price_max    = fields.estimatedPriceMax;
  if (fields.estimatedDurationMin !== undefined) partial.duration_min = fields.estimatedDurationMin;
  if (fields.estimatedDurationMax !== undefined) partial.duration_max = fields.estimatedDurationMax;
  if (fields.date           !== undefined) partial.date          = fields.date;
  if (fields.startTime      !== undefined) partial.start_time    = fields.startTime;
  if (fields.endTime        !== undefined) partial.end_time      = fields.endTime;
  if (fields.groomerId      !== undefined) partial.groomer_id    = fields.groomerId;
  if (fields.status         !== undefined) partial.status        = fields.status;
  if (fields.notes          !== undefined) partial.notes         = fields.notes;

  try {
    const res = await fetch(
      SUPABASE_URL + '/rest/v1/bookings?id=eq.' + encodeURIComponent(id),
      { method: 'PATCH', headers: SB_HEADERS, body: JSON.stringify(partial) }
    );
