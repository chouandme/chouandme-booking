function saveEdit() {
  const bk = bookings.find(b => b.id === modalBkId);
  if (!bk) return;
  const errEl = document.getElementById('editErr');
  errEl.classList.remove('visible');

  const newDate    = document.getElementById('editDate').value;
  const newGroomer = document.getElementById('editGroomer').value;
  const newStart   = document.getElementById('editStart').value;
  const newEnd     = document.getElementById('editEnd').value;
  const newStatus  = document.getElementById('editStatus').value;
  const newNotes   = document.getElementById('editNotes').value;

  // Validate
  if (!newDate || !newStart || !newEnd) {
    errEl.textContent = 'กรุณากรอกข้อมูลให้ครบถ้วน'; errEl.classList.add('visible'); return;
  }
  const dow = new Date(newDate + 'T12:00:00').getDay();
  if (dow === 1) {
    errEl.textContent = 'วันจันทร์ร้านปิด กรุณาเลือกวันอื่น'; errEl.classList.add('visible'); return;
  }
  const [sh, sm] = newStart.split(':').map(Number);
  const [eh, em] = newEnd.split(':').map(Number);
  if (sh < 9 || sh >= 19) {
    errEl.textContent = 'เวลาเริ่มต้องอยู่ระหว่าง 09:00–19:00'; errEl.classList.add('visible'); return;
  }
  if (eh * 60 + em <= sh * 60 + sm) {
    errEl.textContent = 'เวลาสิ้นสุดต้องหลังเวลาเริ่ม'; errEl.classList.add('visible'); return;
  }
  const newDur = (eh * 60 + em) - (sh * 60 + sm);
  // Check groomer overlap (excluding self)
  const overlap = bookings.filter(b =>
    b.id !== bk.id &&
    b.date === newDate &&
    b.groomerId === newGroomer &&
    b.status !== 'ยกเลิก' &&
    overlaps(b.startTime, b.estimatedDurationMax, newStart, newDur)
  );
  if (overlap.length > 0) {
    errEl.textContent = 'ช่วงเวลาดังกล่าวชนกับการจองอื่นของช่างคนนี้'; errEl.classList.add('visible'); return;
  }

  // Apply locally
  bk.date = newDate;
  bk.groomerId = newGroomer;
  bk.startTime = newStart;
  bk.endTime   = newEnd;
  bk.estimatedDurationMin = newDur;
  bk.estimatedDurationMax = newDur;
  bk.status = newStatus;
  bk.notes  = newNotes;

  // Persist to Supabase
  updateBooking(bk.id, { date: bk.date, groomerId: bk.groomerId, startTime: bk.startTime, endTime: bk.endTime, estimatedDurationMin: bk.estimatedDurationMin, estimatedDurationMax: bk.estimatedDurationMax, status: bk.status, notes: bk.notes });

  document.getElementById('modalOverlay').classList.add('hidden');
  showToast('บันทึกการแก้ไขเรียบร้อยแล้ว ✓', 'success');
  renderCurrentView(); buildAdminStats();
}

