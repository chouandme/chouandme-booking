async function updateBooking(id, fields) {
  if (!id) { console.warn('updateBooking: no id, skipping'); return; }
  // Build partial DB object from only the changed frontend fields
  const partial = {};
  if (fields.customerName   !== undefined) partial.customer_name = fields.customerName;
  if (fields.phone          !== undefined) partial.phone         = fields.phone;
  if (fields.petName        !== undefined) partial.pet_name      = fields.petName;
