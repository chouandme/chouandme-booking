    alert('เกิดข้อผิดพลาดในการจอง กรุณาลองใหม่อีกครั้ง\n\n' + err.message);
  }
}

function calcEndTimeStr(start, durationMin) {
  // Guard: if start is null/undefined, return fallback
  if (!start || typeof start !== 'string' || !start.includes(':')) {
    return '10:00';
  }
  const parts = start.split(':').map(Number);
  const h = parts[0] || 0;
  const m = parts[1] || 0;
  const total = h * 60 + m + (durationMin || 60);
  const eh = Math.floor(total / 60) % 24;
  const em = total % 60;
  return String(eh).padStart(2, '0') + ':' + String(em).padStart(2, '0');
}

