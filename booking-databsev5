// ── HELPERS ──
function getKg(w){
  if(!w) return 5;
  if(w.includes('ต่ำกว่า 2.5')) return 2;
  if(w.includes('2.5–5')||w.includes('ต่ำกว่า 3')||w.includes('3–5')) return 4;
  if(w.includes('5.1–10')) return 7;
  if(w.includes('10.1–15')) return 12;
  if(w.includes('15.1–25')) return 20;
  if(w.includes('25.1–40')) return 30;
  if(w.includes('มากกว่า 40')) return 45;
  if(w.includes('มากกว่า 10')) return 12;
  return 5;
}
function isHeavy(){ return getKg(S.weight)>=10; }

// Bath key: long/thick/matted → bath_long, else → bath_short
function getBathKey(){ return (S.coat==='long'||S.coat==='thick'||S.coat==='matted')?'bath_long':'bath_short'; }

function calcPrice(){
  if(!S.weight) return {min:0,max:0};
  const tbl=S.petType==='dog'?dogPrices:catPrices;
  const row=tbl[S.weight]; if(!row) return {min:0,max:0};
  const bk=getBathKey();
  let base=row[bk]||0;
  if(S.haircut==='clipper') base+=row['trim']||0;
  if(S.haircut==='scissor') base+=row['scissor']||0;
  let mn=0,mx=0;
  const hv=isHeavy();
  S.addons.forEach(av=>{
    const a=addons.find(x=>x.val===av);
    if(a){mn+=hv?a.prH[0]:a.prL[0];mx+=hv?a.prH[1]:a.prL[1];}
  });
  return {min:base+mn,max:base+mx};
}

function calcDuration(){
  const kg=getKg(S.weight); let mn=60,mx=90;
  if(kg<5){mn=60;mx=90;}else if(kg<=10){mn=75;mx=105;}else if(kg<=20){mn=90;mx=120;}else if(kg<=40){mn=105;mx=150;}else{mn=120;mx=180;}
  if(S.coat==='long'){mn+=30;mx+=60;}
  if(S.coat==='thick'){mn+=30;mx+=60;}
  if(S.coat==='matted'){mn+=45;mx+=90;}
  if(S.haircut==='clipper'){mn+=45;mx+=90;}
  if(S.haircut==='scissor'){mn+=60;mx+=120;}
  S.addons.forEach(av=>{const a=addons.find(x=>x.val===av);if(a){mn+=a.dur[0];mx+=a.dur[1];}});
  return{mn,mx};
}

function fmtDur(mn,mx){
  const sMin=Math.floor(mn/60)+(mn%60>=30?.5:0);
  const sMax=Math.floor(mx/60)+(mx%60>=30?.5:0);
  if(sMin===sMax) return `ประมาณ ${sMin} ชั่วโมง`;
  return `ประมาณ ${sMin}–${sMax} ชั่วโมง`;
}

