function canBook(date, time, dur, excludeId = null) {
  const overlap = bookings.filter(b =>
    b.id !== excludeId &&
    b.date === date &&
    b.status !== 'ยกเลิก' &&
    overlaps(b.startTime, b.estimatedDurationMax, time, dur)
  );
  return overlap.length < 2;
}

