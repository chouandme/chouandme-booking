// ── DAILY RENDER ──
const HOUR_START = 9;
const HOUR_END   = 19;
const SLOT_PX    = 30; // px per 30 minutes
const MIN_PER_PX = 30 / SLOT_PX; // 1 px = 1 minute

function minsFromOpen(timeStr) {
  if (!timeStr || !timeStr.includes(':')) return 0;
  const [h, m] = timeStr.split(':').map(Number);
  return (h - HOUR_START) * 60 + m;
}
function pxFromOpen(timeStr)   { return minsFromOpen(timeStr) / 30 * SLOT_PX; }
function pxToTime(px)          {
  const totalMins = Math.round(px / SLOT_PX) * 30 + HOUR_START * 60;
  const h = Math.floor(totalMins / 60), m = totalMins % 60;
  return String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0');
}
function totalPx()             { return (HOUR_END - HOUR_START) * 2 * SLOT_PX; }
const HEADER_H = 44; // px height of groomer header row

function getGroomerBks(groomer) {
  return bookings.filter(b =>
    b.date === adminDaySelected &&
    b.status !== 'ยกเลิก' &&
    (b.groomerId === groomer || (!b.groomerId && groomer === 'groomer1'))
  );
}

function autoAssignGroomers() {
  // Only assign groomerId to bookings that don't have one yet.
  // Never overwrite an explicit assignment made by drag or edit.
  const byDate = {};
  bookings.filter(b => b.status !== 'ยกเลิก').forEach(b => {
    if (!byDate[b.date]) byDate[b.date] = [];
    byDate[b.date].push(b);
  });

  Object.values(byDate).forEach(dayBks => {
    dayBks.sort((a, b) => (a.startTime || '').localeCompare(b.startTime || ''));
    // First pass: respect existing assignments
    // Second pass: assign missing ones to whichever groomer fits
    dayBks.forEach(b => {
      if (b.groomerId) return; // already assigned — leave it
      // Find first groomer with no overlap
      const g1Clash = dayBks.some(x =>
        x.id !== b.id && x.groomerId === 'groomer1' &&
        overlaps(x.startTime, x.estimatedDurationMax, b.startTime, b.estimatedDurationMax)
      );
      b.groomerId = g1Clash ? 'groomer2' : 'groomer1';
    });
  });
}

function renderDaily() {
